# Godot 4+ specific ignores
# (based on the official template: https://github.com/github/gitignore/blob/main/Godot.gitignore)
.godot/
# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp
# Imported translations (automatically generated from CSV files)
*.translation
# Godot 4.2+ specific ignores
~*.dll

# Mono / C# — uncomment only if you switch to the .NET build
# .mono/
# data_*/
# mono_crash.*.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python (local tooling)
__pycache__/
*.py[cod]
.venv/
venv/

# Export outputs — uncomment if you do not want builds in git
# *.exe
# *.pck
